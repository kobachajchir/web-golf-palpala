{
  "name": "web-golf-palpala",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "seed:accounting": "powershell -ExecutionPolicy Bypass -File .\\scripts\\seed-accounting-emulator.ps1",
    "seed:members": "powershell -ExecutionPolicy Bypass -File .\\scripts\\seed-members-full-emulator.ps1",
    "seed:members:registry": "powershell -ExecutionPolicy Bypass -File .\\scripts\\seed-users-emulator.ps1",
    "seed:member-auth-users": "powershell -ExecutionPolicy Bypass -File .\\scripts\\seed-member-auth-users-emulator.ps1",
    "import:members:dry-run": "powershell -ExecutionPolicy Bypass -Command \"Push-Location .\\functions; npm run import:palpala-members:dry-run; Pop-Location\"",
    "seed:dev-directivo": "powershell -ExecutionPolicy Bypass -File .\\scripts\\seed-dev-directivo-emulator.ps1",
    "seed:executive-board": "powershell -ExecutionPolicy Bypass -File .\\scripts\\seed-executive-board-emulator.ps1",
    "seed:test-employees": "powershell -ExecutionPolicy Bypass -File .\\scripts\\seed-test-employees-emulator.ps1",
    "seed:requested-family-groups": "powershell -ExecutionPolicy Bypass -File .\\scripts\\seed-requested-family-groups-emulator.ps1",
    "emulators:start:users": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-users-emulators.ps1"
  },
  "dependencies": {
    "firebase": "^12.12.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.9"
  }
}
